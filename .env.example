# Neon Postgres connection string (Vercel injects this automatically when you add Neon via Storage)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared secret used by the iPhone Shortcut and the PWA. Make it long and random:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_SECRET=change-me
